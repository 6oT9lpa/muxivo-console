FROM python:3.12-slim

WORKDIR /workspace

COPY pyproject.toml ./
COPY apps/api/src ./apps/api/src
COPY alembic ./alembic
COPY alembic.ini ./

RUN pip install --no-cache-dir -e .

CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn muxivo_console.asgi_development:app --app-dir apps/api/src --host 0.0.0.0 --port 8000"]
