# Prometheus configuration for a same-host Console deployment.
# The API binds to loopback and Nginx keeps /metrics out of the public browser
# surface, so Prometheus should run on this host or use an internal tunnel.
# Do not expose this target directly to the public Internet.

global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Alertmanager is a same-host/private monitoring service. Configure its
# receiver separately and keep its credentials out of this repository.
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 127.0.0.1:9093

rule_files:
  - /etc/prometheus/rules/muxivo-console-alerts.yml

scrape_configs:
  - job_name: muxivo-console
    scrape_interval: 15s
    scrape_timeout: 5s
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:8010
        labels:
          service: muxivo-console
          environment: production
