# Single-node HashiCorp Vault server for an isolated staging host.
#
# This configuration deliberately binds Vault to loopback. Production should
# use an approved HA or managed Vault topology before public launch.

ui            = false
api_addr      = "https://127.0.0.1:8200"
cluster_addr  = "https://127.0.0.1:8201"
disable_mlock = false

storage "raft" {
  path    = "/var/lib/vault/data"
  node_id = "muxivo-console-vault-staging-1"
}

listener "tcp" {
  address         = "127.0.0.1:8200"
  cluster_address = "127.0.0.1:8201"
  tls_cert_file   = "/etc/vault.d/tls/vault.crt"
  tls_key_file    = "/etc/vault.d/tls/vault.key"
  tls_min_version = "tls13"
}

telemetry {
  disable_hostname = true
}
