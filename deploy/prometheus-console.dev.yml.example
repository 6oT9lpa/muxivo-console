# Development-only Prometheus configuration for the Docker Compose API.
# The production configuration must use deploy/prometheus-console.yml.example
# and a loopback or private monitoring target instead.

global:
  scrape_interval: 5s
  evaluation_interval: 5s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/muxivo-console-alerts.yml

scrape_configs:
  - job_name: muxivo-console
    scrape_interval: 5s
    scrape_timeout: 2s
    metrics_path: /metrics
    static_configs:
      - targets:
          - api:8000
        labels:
          service: muxivo-console
          environment: development
