# This is a variable reference only. Do not use it as a production secret file.
# Render the real file through the selected secret manager and install it at
# /etc/muxivo-console/console.env with root ownership and mode 0600.

MUXIVO_CONSOLE_ENVIRONMENT=production
MUXIVO_CONSOLE_SECRET_SOURCE=hashicorp-vault
MUXIVO_CONSOLE_PUBLIC_BASE_URL=https://console.muxivo.pro
MUXIVO_CONSOLE_CORS_ALLOWED_ORIGINS=https://console.muxivo.pro

MUXIVO_CONSOLE_DATABASE_URL=postgresql+asyncpg://muxivo_console:<database-password>@127.0.0.1:5432/muxivo_console
MUXIVO_CONSOLE_EMAIL_LOOKUP_KEY=<base64-key-at-least-32-bytes>
MUXIVO_CONSOLE_EMAIL_ENCRYPTION_KEY=<fernet-key>
MUXIVO_CONSOLE_SESSION_TOKEN_PEPPER=<base64-key-at-least-32-bytes>

# Point this to the signed Discord Control API, not to the Discord Activity UI.
MUXIVO_DISCORD_CONTROL_BASE_URL=https://discord-control.internal
MUXIVO_DISCORD_CONTROL_SIGNING_KEY=<base64-service-signing-key>

MUXIVO_CONSOLE_RATE_LIMIT_BACKEND=redis
MUXIVO_CONSOLE_RATE_LIMIT_REDIS_URL=rediss://<redis-user>:<redis-password>@<redis-host>:6379/0

MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_HOST=connect.smtp.bz
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_PORT=587
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_STARTTLS=true
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_USERNAME=<smtp.bz-login>
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_PASSWORD=<smtp.bz-password>
MUXIVO_CONSOLE_PASSWORD_RECOVERY_FROM_EMAIL=security@muxivo.pro
MUXIVO_CONSOLE_PASSWORD_RECOVERY_RESET_URL_BASE=https://console.muxivo.pro/recover
MUXIVO_CONSOLE_ORGANIZATION_INVITATION_URL_BASE=https://console.muxivo.pro/accept-invitation

MUXIVO_DISCORD_OAUTH_CLIENT_ID=<discord-client-id>
MUXIVO_DISCORD_OAUTH_CLIENT_SECRET=<discord-client-secret>
MUXIVO_DISCORD_OAUTH_REDIRECT_URI=https://console.muxivo.pro/api/v1/auth/discord/callback

MUXIVO_TWITCH_OAUTH_CLIENT_ID=<twitch-client-id>
MUXIVO_TWITCH_OAUTH_CLIENT_SECRET=<twitch-client-secret>
MUXIVO_TWITCH_OAUTH_REDIRECT_URI=https://console.muxivo.pro/api/v1/auth/twitch/callback

# Optional browser identity providers. Configure all three variables per
# provider to enable the corresponding login/link buttons.
MUXIVO_GOOGLE_OAUTH_CLIENT_ID=<google-client-id>
MUXIVO_GOOGLE_OAUTH_CLIENT_SECRET=<google-client-secret>
MUXIVO_GOOGLE_OAUTH_REDIRECT_URI=https://console.muxivo.pro/api/v1/auth/google/callback

MUXIVO_YANDEX_OAUTH_CLIENT_ID=<yandex-client-id>
MUXIVO_YANDEX_OAUTH_CLIENT_SECRET=<yandex-client-secret>
MUXIVO_YANDEX_OAUTH_REDIRECT_URI=https://console.muxivo.pro/api/v1/auth/yandex/callback

MUXIVO_TELEGRAM_OAUTH_CLIENT_ID=<telegram-bot-client-id>
MUXIVO_TELEGRAM_OAUTH_CLIENT_SECRET=<telegram-client-secret>
MUXIVO_TELEGRAM_OAUTH_REDIRECT_URI=https://console.muxivo.pro/api/v1/auth/telegram/callback

# Required before enabling Twitch ownership and reconciliation flows.
MUXIVO_TWITCH_CONTROL_BASE_URL=https://twitch-control.internal
MUXIVO_TWITCH_CONTROL_SIGNING_KEY=<base64-service-signing-key>
MUXIVO_CONSOLE_CONNECTION_RECONCILIATION_ENABLED=true
MUXIVO_CONSOLE_CONNECTION_RECONCILIATION_SYSTEM_ACTOR_ID=<system-actor-uuid>
MUXIVO_CONSOLE_SECURITY_CLEANUP_ENABLED=true
