# Vault Agent template for the Console systemd credential.
#
# The secret path is KV v2. Every value is quoted by the Go template formatter
# before systemd reads the file as an EnvironmentFile. The template contains
# names only; actual values are read from Vault at runtime.

{{- with secret "secret/data/muxivo-console/staging" }}
MUXIVO_CONSOLE_ENVIRONMENT={{ printf "%q" .Data.data.environment }}
MUXIVO_CONSOLE_SECRET_SOURCE={{ printf "%q" .Data.data.secret_source }}
MUXIVO_CONSOLE_PUBLIC_BASE_URL={{ printf "%q" .Data.data.public_base_url }}
MUXIVO_CONSOLE_CORS_ALLOWED_ORIGINS={{ printf "%q" .Data.data.cors_allowed_origins }}

MUXIVO_CONSOLE_DATABASE_URL={{ printf "%q" .Data.data.database_url }}
MUXIVO_CONSOLE_EMAIL_LOOKUP_KEY={{ printf "%q" .Data.data.email_lookup_key }}
MUXIVO_CONSOLE_EMAIL_ENCRYPTION_KEY={{ printf "%q" .Data.data.email_encryption_key }}
MUXIVO_CONSOLE_SESSION_TOKEN_PEPPER={{ printf "%q" .Data.data.session_token_pepper }}

MUXIVO_DISCORD_CONTROL_BASE_URL={{ printf "%q" .Data.data.discord_control_base_url }}
MUXIVO_DISCORD_CONTROL_SIGNING_KEY={{ printf "%q" .Data.data.discord_control_signing_key }}

MUXIVO_CONSOLE_RATE_LIMIT_BACKEND={{ printf "%q" .Data.data.rate_limit_backend }}
MUXIVO_CONSOLE_RATE_LIMIT_REDIS_URL={{ printf "%q" .Data.data.rate_limit_redis_url }}

MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_HOST={{ printf "%q" .Data.data.smtp_host }}
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_PORT={{ printf "%q" .Data.data.smtp_port }}
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_STARTTLS={{ printf "%q" .Data.data.smtp_starttls }}
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_USERNAME={{ printf "%q" .Data.data.smtp_username }}
MUXIVO_CONSOLE_PASSWORD_RECOVERY_SMTP_PASSWORD={{ printf "%q" .Data.data.smtp_password }}
MUXIVO_CONSOLE_PASSWORD_RECOVERY_FROM_EMAIL={{ printf "%q" .Data.data.smtp_from_email }}
MUXIVO_CONSOLE_PASSWORD_RECOVERY_RESET_URL_BASE={{ printf "%q" .Data.data.recovery_reset_url_base }}
MUXIVO_CONSOLE_ORGANIZATION_INVITATION_URL_BASE={{ printf "%q" .Data.data.invitation_url_base }}

MUXIVO_DISCORD_OAUTH_CLIENT_ID={{ printf "%q" .Data.data.discord_oauth_client_id }}
MUXIVO_DISCORD_OAUTH_CLIENT_SECRET={{ printf "%q" .Data.data.discord_oauth_client_secret }}
MUXIVO_DISCORD_OAUTH_REDIRECT_URI={{ printf "%q" .Data.data.discord_oauth_redirect_uri }}

MUXIVO_TWITCH_OAUTH_CLIENT_ID={{ printf "%q" .Data.data.twitch_oauth_client_id }}
MUXIVO_TWITCH_OAUTH_CLIENT_SECRET={{ printf "%q" .Data.data.twitch_oauth_client_secret }}
MUXIVO_TWITCH_OAUTH_REDIRECT_URI={{ printf "%q" .Data.data.twitch_oauth_redirect_uri }}
{{- if and .Data.data.google_oauth_client_id .Data.data.google_oauth_client_secret .Data.data.google_oauth_redirect_uri }}
MUXIVO_GOOGLE_OAUTH_CLIENT_ID={{ printf "%q" .Data.data.google_oauth_client_id }}
MUXIVO_GOOGLE_OAUTH_CLIENT_SECRET={{ printf "%q" .Data.data.google_oauth_client_secret }}
MUXIVO_GOOGLE_OAUTH_REDIRECT_URI={{ printf "%q" .Data.data.google_oauth_redirect_uri }}
{{- end }}
{{- if and .Data.data.yandex_oauth_client_id .Data.data.yandex_oauth_client_secret .Data.data.yandex_oauth_redirect_uri }}
MUXIVO_YANDEX_OAUTH_CLIENT_ID={{ printf "%q" .Data.data.yandex_oauth_client_id }}
MUXIVO_YANDEX_OAUTH_CLIENT_SECRET={{ printf "%q" .Data.data.yandex_oauth_client_secret }}
MUXIVO_YANDEX_OAUTH_REDIRECT_URI={{ printf "%q" .Data.data.yandex_oauth_redirect_uri }}
{{- end }}
MUXIVO_TWITCH_CONTROL_BASE_URL={{ printf "%q" .Data.data.twitch_control_base_url }}
MUXIVO_TWITCH_CONTROL_SIGNING_KEY={{ printf "%q" .Data.data.twitch_control_signing_key }}

MUXIVO_CONSOLE_CONNECTION_RECONCILIATION_ENABLED={{ printf "%q" .Data.data.connection_reconciliation_enabled }}
MUXIVO_CONSOLE_CONNECTION_RECONCILIATION_SYSTEM_ACTOR_ID={{ printf "%q" .Data.data.connection_reconciliation_system_actor_id }}
MUXIVO_CONSOLE_SECURITY_CLEANUP_ENABLED={{ printf "%q" .Data.data.security_cleanup_enabled }}
{{- end }}
