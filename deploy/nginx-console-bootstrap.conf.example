# Temporary HTTP host for the canonical muxivo.pro certificate bootstrap.
# Install only while the existing muxivo.pro HTTPS vhost is backed up and
# certbot is issuing or renewing the certificate.

server {
    listen 80;
    listen [::]:80;
    server_name muxivo.pro www.muxivo.pro;

    root /srv/muxivo-console/web;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /activity {
        return 308 /activity/;
    }

    location ^~ /activity/ {
        rewrite ^/activity/?(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ~ ^/api/(auth|activity|muxivo-core|welcome|discord|dev-blog|creator-alerts|voice|stats|logs|bot|integrations|media|public)(/|$) {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:18081/healthz;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /readyz {
        proxy_pass http://127.0.0.1:18081/readyz;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
